{
  "name": "apollo-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "prepare": "tsx src/cli/prepare.ts",
    "check": "tsx src/cli/check-environment.ts && tsc --noEmit && vitest run",
    "test:unit": "vitest run --exclude tests/runtime.integration.test.ts",
    "test:integration": "vitest run tests/runtime.integration.test.ts",
    "calibrate": "tsx src/cli/calibrate.ts",
    "campaign": "tsx src/cli/campaign.ts",
    "replay": "tsx src/cli/replay.ts",
    "report": "tsx src/cli/report.ts"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.62.5"
  }
}
